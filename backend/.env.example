PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string — from Atlas: Database > Connect > Drivers.
# Replace <username>, <password> and the host, and keep your database user's
# password URL-encoded if it contains special characters.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=brand_portal
