# Only needed for production/deployed builds. In local dev, leave this unset
# and Vite's proxy (vite.config.js) will forward /api and /uploads to
# http://localhost:4000 automatically.
#
# Set this to your deployed backend's URL, including the /api suffix, e.g.
# on Vercel: Project Settings > Environment Variables.
VITE_API_URL=https://your-backend.onrender.com/api
